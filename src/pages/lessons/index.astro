---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../utils/paths";

const lessons = (await getCollection("lessons", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.lesson - b.data.lesson
);
---

<BaseLayout
  title="レッスン一覧 | Git Guidebook"
  description="Git GuidebookのLesson 0からLesson 11までを一覧で確認できます。"
>
  <section class="page-hero shell">
    <p class="eyebrow">LESSON MAP</p>
    <h1>レッスン一覧</h1>
    <p class="lead">
      ひとつの練習用リポジトリを育てながら、Gitの基本サイクルを順番にたどります。Lesson
      0から進めれば、各レッスンの開始状態が自然につながります。
    </p>
  </section>
  <section class="shell section">
    <ol class="lesson-list">
      {
        lessons.map((lesson) => (
          <li>
            <a href={withBase(`lessons/${lesson.id}/`)}>
              <span class="lesson-number">{String(lesson.data.lesson).padStart(2, "0")}</span>
              <div>
                <h2>{lesson.data.title}</h2>
                <p>{lesson.data.description}</p>
                <dl class="lesson-meta">
                  <div>
                    <dt>操作</dt>
                    <dd>{lesson.data.title}</dd>
                  </div>
                  <div>
                    <dt>できるようになること</dt>
                    <dd>{lesson.data.goals[0]}</dd>
                  </div>
                  <div>
                    <dt>目安時間</dt>
                    <dd>{lesson.data.duration}</dd>
                  </div>
                  <div>
                    <dt>前提</dt>
                    <dd>{lesson.data.prerequisite}</dd>
                  </div>
                  <div>
                    <dt>使う画面</dt>
                    <dd>{lesson.data.interfaces.join("・")}</dd>
                  </div>
                  <div>
                    <dt>コマンド</dt>
                    <dd>{lesson.data.commandOptional ? "任意（折りたたみ解説あり）" : "なし"}</dd>
                  </div>
                </dl>
              </div>
              <span class="list-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
  <section class="shell course-note" aria-labelledby="course-note-title">
    <h2 id="course-note-title">このコースの進め方</h2>
    <p>
      各レッスンでは操作前後の状態図、成功確認、自分で試す課題、用語・状態・次の操作の3問を用意しています。コマンド欄は任意なので、最初はGitHub
      Desktopの本線だけで完走できます。
    </p>
  </section>
</BaseLayout>
